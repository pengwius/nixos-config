+downloadPath :: StorePath
+downloadPath = StorePath "yk1164s4bkj6p3s4mzxm5fc4qn38cnmf" "ghc-8.8.2-doc"
+
+copyStart :: Int -> StorePath -> JSON.NixJSONMessage
+copyStart activityId path = JSON.Start (JSON.MkStartAction (JSON.MkId activityId) JSON.Info "" (JSON.CopyPath path (Host "https://cache.nixos.org") Localhost))
+
+copyProgress :: Int -> Int -> Int -> JSON.NixJSONMessage
+copyProgress activityId completed total = JSON.Result (JSON.MkResultAction (JSON.MkId activityId) (JSON.Progress (JSON.MkActivityProgress completed total 0 0)))
+
+renderState :: State.NOMV1State -> IO Text
+renderState nomState = do
+  now <- getZonedTime
+  pure $ stripANSICodes $ stateToText (MkConfig False False) nomState Nothing (now, nomState.startTime + 2)
+
+renderMessages :: [JSON.NixJSONMessage] -> IO Text
+renderMessages messages = renderState =<< stateFromMessages messages
+
+stateFromMessages :: [JSON.NixJSONMessage] -> IO State.NOMV1State
+stateFromMessages messages = do
+  initial <- State.initalStateFromBuildPlatform Nothing
+  foldM (\old message -> do
+    ((errs, _), new) <- updateStateNixJSONMessage message old
+    assertEqual "no update errors" [] errs
+    pure (fromMaybe old new)) initial messages
+
+withDownloadTree :: State.NOMV1State -> State.NOMV1State
+withDownloadTree = execState do
+  pathId <- State.getStorePathId downloadPath
+  childId <- State.getDerivationId (Derivation downloadPath)
+  parentId <- State.getDerivationId (Derivation (StorePath "60zb5dndaw1fzir3s69sy3xhy19gll1p" "tree-root"))
+  modify' \s -> s
+    { State.forestRoots = one parentId
+    , State.derivationInfos =
+        CMap.adjust (\parent -> parent{State.inputDerivations = one (State.MkInputDerivation childId (one State.Out)), State.dependencySummary = s.fullSummary}) parentId
+          (CMap.adjust (\child -> child{State.outputs = Map.singleton State.Out pathId, State.dependencySummary = s.fullSummary}) childId s.derivationInfos)
+    , State.storePathInfos = CMap.adjust (\info -> info{State.producer = Strict.Just childId}) pathId s.storePathInfos
+    }
+
+downloadRow :: Text -> Text
+downloadRow = Text.unlines . filter (Text.isInfixOf downloadPath.name) . Text.lines
+
