 showCond :: (Monoid m) => Bool -> m -> m
 showCond = memptyIfFalse
 
+progressBar :: Int -> Int -> Text
+progressBar completed total
+  | total <= 0 = ""
+  | otherwise =
+      "[" <> Text.replicate filled "█" <> Text.replicate (12 - filled) "░" <> "] " <> show percent <> "%"
+ where
+  -- Use Integer so large byte counters cannot overflow when scaled.
+  amount = toInteger (max 0 (min completed total))
+  filled = fromInteger (amount * 12 `div` toInteger total)
+  percent = amount * 100 `div` toInteger total
+
 targetRatio, defaultTreeMax :: Int
