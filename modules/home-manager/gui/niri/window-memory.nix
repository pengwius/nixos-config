{ pkgs, ... }:
let
  # Always use the static window rules from config.kdl for these apps.
  excludeAppIds = [ "com.mitchellh.ghostty" ];

  helper = pkgs.writeShellApplication {
    name = "niri-window-memory";
    runtimeInputs = with pkgs; [
      coreutils
      jq
      niri
    ];
    text = ''
      set -euo pipefail

      config_home="''${XDG_CONFIG_HOME:-$HOME/.config}"
      state_home="''${XDG_STATE_HOME:-$HOME/.local/state}"
      rules_file="$config_home/niri/window-memory.kdl"
      state_file="$state_home/niri-window-memory/state.json"
      valid_id='^[A-Za-z0-9._:/@+-]+$'
      exclude_json='${builtins.toJSON excludeAppIds}'

      mkdir -p "$(dirname "$rules_file")" "$(dirname "$state_file")"

      state='{}'
      if [[ -s "$state_file" ]]; then
        state=$(jq -c --argjson exclude "$exclude_json" '
          if type == "object"
          then with_entries(select(.key as $k | ($exclude | index($k) | not)))
          else {}
          end
        ' "$state_file" 2>/dev/null || printf '{}')
      fi

      write_if_changed() {
        local file="$1" content="$2"
        if [[ -f "$file" ]] && [[ "$(< "$file")" == "$content" ]]; then
          return 0
        fi
        printf '%s\n' "$content" >"$file.tmp"
        mv "$file.tmp" "$file"
      }

      write_rules() {
        local text
        text=$(jq -r --argjson exclude "$exclude_json" '
          "// Generated by niri-window-memory. Do not edit by hand.",
          "// Included at the end of config.kdl, so these override earlier rules.",
          "// Apps listed in excludeAppIds never appear here.",
          "",
          (to_entries
            | map(select(.key as $k | ($exclude | index($k) | not)))
            | sort_by(.key)[]
            | "window-rule {",
              "    match app-id=r#\"^" + (.key | split(".") | join("\\.") | split("+") | join("\\+")) + "$\"#",
              "    open-floating " + (if .value.floating then "true" else "false" end),
              "    default-column-width { fixed " + (.value.width | tostring) + "; }",
              (if .value.floating
                then "    default-window-height { fixed " + (.value.height | tostring) + "; }"
                else empty end),
              "}",
              "")
        ' <<<"$state")
        write_if_changed "$rules_file" "$text"
      }

      write_state() {
        write_if_changed "$state_file" "$state"
      }

      trap 'write_rules; write_state; exit 0' TERM INT

      write_rules
      write_state

      # Each line is "<rewrite-rules>\t<state>"; rules are rewritten on close.
      while :; do
        while IFS=$'\t' read -r write_flag new_state; do
          [[ -n "$new_state" ]] || continue
          if [[ "$new_state" != "$state" ]]; then
            state="$new_state"
            write_state
          fi
          if [[ "$write_flag" == "1" ]]; then
            write_rules
          fi
        done < <(niri msg --json event-stream 2>/dev/null | jq -n -r -c --unbuffered \
          --argjson seed "$state" \
          --arg re "$valid_id" \
          --argjson exclude "$exclude_json" '
          def win_size($w):
            (($w.layout.window_size // $w.layout.tile_size) // []) as $s
            | if (($s | type) == "array") and (($s | length) == 2)
                and ($s[0] >= 100) and ($s[0] <= 20000)
                and ($s[1] >= 100) and ($s[1] <= 20000)
              then { width: ($s[0] | round), height: ($s[1] | round) }
              else null end;

          def remember($w):
            ($w.app_id // "") as $id
            | if ($id | test($re)) and ($exclude | index($id) | not)
              then win_size($w) as $z
                | if $z != null
                  then .[$id] = {
                    floating: ($w.is_floating // false),
                    width: $z.width,
                    height: $z.height
                  }
                  else . end
              else . end;

          foreach inputs as $e (
            { w: {}, s: $seed, write: false };

            if $e.WindowsChanged then
              .w = (reduce $e.WindowsChanged.windows[] as $x ({}; .[($x.id | tostring)] = $x))
              | .s = (reduce $e.WindowsChanged.windows[] as $x (.s; remember($x)))
              | .write = true
            elif $e.WindowOpenedOrChanged then
              ($e.WindowOpenedOrChanged.window) as $x
              | .w[($x.id | tostring)] = $x
              | .s = (.s | remember($x))
              | .write = false
            elif $e.WindowLayoutsChanged then
              .write = false
              | reduce $e.WindowLayoutsChanged.changes[] as $c (.;
                  ($c[0] | tostring) as $id
                  | .w[$id].layout = $c[1]
                  | . as $acc
                  | .s = ($acc.s | remember($acc.w[$id])))
            elif $e.WindowClosed then
              .w |= del(.[($e.WindowClosed.id | tostring)])
              | .write = true
            else
              .write = false
            end;

            if ($e | has("WindowsChanged") or has("WindowOpenedOrChanged")
                    or has("WindowLayoutsChanged") or has("WindowClosed"))
            then "\(if .write then 1 else 0 end)\t\(.s | tojson)"
            else empty end
          )
        ')
        sleep 1
      done
    '';
  };
in
{
  systemd.user.services.niri-window-memory = {
    Unit = {
      Description = "Remember niri window size and floating state";
      After = [ "niri.service" ];
      PartOf = [ "graphical-session.target" ];
    };

    Service = {
      ExecStart = "${helper}/bin/niri-window-memory";
      Restart = "on-failure";
      RestartSec = 1;
    };

    Install.WantedBy = [ "graphical-session.target" ];
  };
}
